{"cells":[{"cell_type":"markdown","id":"09724809","metadata":{},"source":["# Legadia — anuncio cinematográfico de 10 segundos\n","\n","Pipeline sin APIs de vídeo de pago:\n","\n","- CogVideoX-5B INT8 en Google Colab T4\n","- Edge TTS para voz masculina española\n","- LatentSync 1.5 para sincronización labial\n","- FFmpeg y Pillow para sonido, texto exacto y exportación 1080p\n","\n","Ejecute las celdas en orden. Seleccione antes **Entorno de ejecución → Cambiar tipo de entorno de ejecución → T4 GPU**.\n"]},{"cell_type":"code","execution_count":null,"id":"0dfa89f8","metadata":{},"outputs":[],"source":["# 1. Preparación\n","!nvidia-smi\n","!apt-get -qq update\n","!apt-get -qq install -y ffmpeg fonts-dejavu-core libgl1\n","\n","from pathlib import Path\n","import os, subprocess, json, shutil, gc, math\n","\n","ROOT = Path(\"/content/legadia\")\n","OUT = ROOT / \"output\"\n","OUT.mkdir(parents=True, exist_ok=True)\n","\n","assert shutil.which(\"nvidia-smi\"), \"Active una GPU T4 en Colab antes de continuar.\"\n","print(\"Directorio de salida:\", OUT)\n"]},{"cell_type":"code","execution_count":null,"id":"04275afe","metadata":{},"outputs":[],"source":["# 2. Brief y prompt definitivo\n","TITLE = \"Legadia — vídeo publicitario disruptivo\"\n","\n","PROMPT = \"\"\"\n","A premium high-budget outdoor advertising film beside Madrid-Barajas Airport. A crowded modern glass bus shelter stands next to airport terminal architecture, with aircraft visible in the distance. Spanish travellers carrying suitcases move quickly past the shelter. The camera performs a fast smooth cinematic lateral tracking shot.\n","\n","Inside the glass shelter, a large vertical digital billboard shows a confident Spanish man around 55 years old wearing an elegant dark navy-blue jacket. His face is large, clear, frontal and well lit. He suddenly comes alive inside the advertisement, turns his head, locks eyes with one specific Spanish male passerby around 50 years old, leans forward and points directly at him while speaking.\n","\n","The digital screen bends dramatically outward in a controlled anamorphic 3D advertising effect. Old family photographs, inheritance documents, sealed envelopes and glowing warm-gold genealogical lines burst out of the screen into the real world. Brief dramatic slow motion: the photographs, papers and golden lines remain suspended in the air. One golden line travels through the crowd and connects the billboard man to the selected passerby. Everyone else freezes. The selected passerby stops and reacts with genuine astonishment.\n","\n","The billboard man remains clearly visible and keeps pointing. Finish with a fast cinematic push-in toward the astonished passerby's face, then return toward the illuminated digital billboard. Photorealistic Spanish people, realistic Madrid airport environment, electric blue and warm gold palette, strong cinematic contrast, premium international advertising, smooth stable camera, emotionally provocative, no logos and no readable text inside the generated video.\n","\"\"\".strip()\n","\n","NEGATIVE_PROMPT = \"\"\"\n","office, lawyers, meetings, conventional corporate imagery, fantasy, horror, comedy,\n","English signs, logos, readable generated text, Latin American styling, distorted faces,\n","duplicated people, deformed hands, extra fingers, camera shake, low resolution, cartoon,\n","illustration, oversaturated colors, warped suitcases\n","\"\"\".replace(\"\\n\", \" \ ").strip()\n","\n","VOICE_PART_1 = \"Usted aún no lo sabe, pero le estamos buscando porque puede tener parte de una herencia.\"\n","VOICE_PART_2 = \"Descubra su caso ahora.\"\n","\n","FINAL_LINES = [\n","    \"USTED AÚN NO LO SABE.\",\n","    \"PERO LE ESTAMOS BUSCANDO.\",\n","    \"PUEDE TENER PARTE DE UNA HERENCIA.\"\n","]\n","CTA = \"DESCUBRA SU CASO AHORA\"\n","\n","config = {\n","    \"title\": TITLE,\n","    \"prompt\": PROMPT,\n","    \"negative_prompt\": NEGATIVE_PROMPT,\n","    \"duration_seconds\": 10,\n","    \"aspect_ratio\": \"16:9\",\n","    \"voice_part_1\": VOICE_PART_1,\n","    \"voice_part_2\": VOICE_PART_2,\n","    \"final_lines\": FINAL_LINES,\n","    \"cta\": CTA\n","}\n","(OUT / \"legadia_request.json\").write_text(json.dumps(config, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n","print(json.dumps(config, ensure_ascii=False, indent=2))\n"]},{"cell_type":"code","execution_count":null,"id":"3267d6c0","metadata":{},"outputs":[],"source":["# 3. Instalación del generador gratuito\n","!pip -q install \\\n","  \"torch==2.5.1\" \"torchvision==0.20.1\" \\\n","  \"diffusers==0.32.2\" \"transformers==4.48.0\" \\\n","  \"accelerate==1.2.1\" \"huggingface-hub==0.30.2\" \\\n","  \"torchao==0.7.0\" sentencepiece imageio imageio-ffmpeg \\\n","  edge-tts pillow scipy\n","\n","print(\"Dependencias instaladas.\")\n"]},{"cell_type":"code","execution_count":null,"id":"22fb9555","metadata":{},"outputs":[],"source":["# 4. Generación de un plano continuo de aproximadamente 10 segundos\n","import torch\n","from diffusers import (\n","    AutoencoderKLCogVideoX,\n","    CogVideoXTransformer3DModel,\n","    CogVideoXPipeline,\n","    CogVideoXDPMScheduler,\n",")\n","from diffusers.utils import export_to_video\n","from transformers import T5EncoderModel\n","from torchao.quantization import quantize_, int8_weight_only\n","\n","MODEL_ID = \"THUDM/CogVideoX-5b\"\n","BASE_VIDEO = OUT / \"legadia_base_10s.mp4\"\n","\n","def quantize_int8(module):\n","    quantize_(module, int8_weight_only())\n","    return module\n","\n","dtype = torch.bfloat16\n","\n","print(\"Cargando y cuantizando el codificador de texto...\")\n","text_encoder = T5EncoderModel.from_pretrained(\n","    MODEL_ID, subfolder=\"text_encoder\", torch_dtype=dtype\n",")\n","text_encoder = quantize_int8(text_encoder)\n","\n","print(\"Cargando y cuantizando el transformador...\")\n","transformer = CogVideoXTransformer3DModel.from_pretrained(\n","    MODEL_ID, subfolder=\"transformer\", torch_dtype=dtype\n",")\n","transformer = quantize_int8(transformer)\n","\n","print(\"Cargando y cuantizando el VAE...\")\n","vae = AutoencoderKLCogVideoX.from_pretrained(\n","    MODEL_ID, subfolder=\"vae\", torch_dtype=dtype\n",")\n","vae = quantize_int8(vae)\n","\n","pipe = CogVideoXPipeline.from_pretrained(\n","    MODEL_ID,\n","    text_encoder=text_encoder,\n","    transformer=transformer,\n","    vae=vae,\n","    torch_dtype=dtype,\n",")\n","pipe.scheduler = CogVideoXDPMScheduler.from_config(\n","    pipe.scheduler.config, timestep_spacing=\"trailing\"\n",")\n","pipe.enable_model_cpu_offload()\n","pipe.vae.enable_slicing()\n","pipe.vae.enable_tiling()\n","\n","generator = torch.Generator(device=\"cuda\").manual_seed(246801)\n","\n","result = pipe(\n","    prompt=PROMPT,\n","    negative_prompt=NEGATIVE_PROMPT,\n","    num_videos_per_prompt=1,\n","    num_inference_steps=50,\n","    num_frames=81,\n","    guidance_scale=6.0,\n","    use_dynamic_cfg=True,\n","    generator=generator,\n",")\n","frames = result.frames[0]\n","export_to_video(frames, str(BASE_VIDEO), fps=8)\n","\n","del pipe, transformer, text_encoder, vae, result, frames\n","gc.collect()\n","torch.cuda.empty_cache()\n","\n","print(\"Vídeo base:\", BASE_VIDEO)\n"]},{"cell_type":"code","execution_count":null,"id":"8329f81e","metadata":{},"outputs":[],"source":["# 5. Conversión a 16:9, 25 fps y separación del tramo con labios\n","PREP_VIDEO = OUT / \"legadia_base_16x9_25fps.mp4\"\n","LIPS_VIDEO = OUT / \"legadia_visual_8_2s.mp4\"\n","\n","subprocess.run([\n","    \"ffmpeg\", \"-y\", \"-i\", str(BASE_VIDEO),\n","    \"-vf\",\n","    \"crop=ih*16/9:ih:(iw-ih*16/9)/2:0,\"\n","    \"scale=1280:720:flags=lanczos,\"\n","    \"minterpolate=fps=25:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1\",\n","    \"-t\", \"10\",\n","    \"-an\",\n","    \"-c:v\", \"libx264\", \"-preset\", \"slow\", \"-crf\", \"16\",\n","    \"-pix_fmt\", \"yuv420p\",\n","    str(PREP_VIDEO)\n","], check=True)\n","\n","subprocess.run([\n","    \"ffmpeg\", \"-y\", \"-i\", str(PREP_VIDEO),\n","    \"-t\", \"8.2\",\n","    \"-an\",\n","    \"-c:v\", \"libx264\", \"-preset\", \"slow\", \"-crf\", \"16\",\n","    \"-pix_fmt\", \"yuv420p\",\n","    str(LIPS_VIDEO)\n","], check=True)\n","\n","print(PREP_VIDEO)\n","print(LIPS_VIDEO)\n"]},{"cell_type":"code","execution_count":null,"id":"ef8d5d3c","metadata":{},"outputs":[],"source":["# 6. Voz española gratuita y ajuste exacto de duración\n","import asyncio, edge_tts\n","\n","VOICE = \"es-ES-AlvaroNeural\"\n","RAW_1 = OUT / \"voice_part_1_raw.mp3\"\n","RAW_2 = OUT / \"voice_part_2_raw.mp3\"\n","VOICE_1 = OUT / \"voice_part_1_8s.wav\"\n","VOICE_2 = OUT / \"voice_part_2_1_5s.wav\"\n","\n","async def make_voice():\n","    await edge_tts.Communicate(\n","        VOICE_PART_1, VOICE, rate=\"-2%\", pitch=\"-2Hz\"\n","    ).save(str(RAW_1))\n","    await edge_tts.Communicate(\n","        VOICE_PART_2, VOICE, rate=\"-2%\", pitch=\"-2Hz\"\n","    ).save(str(RAW_2))\n","\n","await make_voice()\n","\n","def duration(path):\n","    value = subprocess.check_output([\n","        \"ffprobe\", \"-v\", \"error\", \"-show_entries\",\n","        \"format=duration\", \"-of\", \"default=nw=1:nk=1\", str(path)\n","    ]).decode().strip()\n","    return float(value)\n","\n","def fit_audio(source, target, seconds):\n","    original = duration(source)\n","    tempo = original / seconds\n","    if not 0.5 <= tempo <= 2.0:\n","        raise RuntimeError(f\"atempo fuera de rango: {tempo:.3f}\")\n","    subprocess.run([\n","        \"ffmpeg\", \"-y\", \"-i\", str(source),\n","        \"-filter:a\", f\"atempo={tempo:.6f},apad=pad_dur={seconds}\",\n","        \"-t\", str(seconds),\n","        \"-ar\", \"16000\", \"-ac\", \"1\",\n","        \"-c:a\", \"pcm_s16le\",\n","        str(target)\n","    ], check=True)\n","\n","fit_audio(RAW_1, VOICE_1, 8.0)\n","fit_audio(RAW_2, VOICE_2, 1.5)\n","\n","print(\"Voz principal:\", VOICE_1, duration(VOICE_1))\n","print(\"CTA:\", VOICE_2, duration(VOICE_2))\n"]},{"cell_type":"code","execution_count":null,"id":"4daa4e45","metadata":{},"outputs":[],"source":["# 7. LatentSync 1.5 en un entorno aislado y sin API de pago\n","!pip -q install uv\n","!rm -rf /content/LatentSync /content/latentsync_env\n","!git clone -q https://github.com/bytedance/LatentSync.git /content/LatentSync\n","!cd /content/LatentSync && git checkout -q 75a4a1733c7314a8f6bf092f1fbe4ced008cccd7\n","\n","!uv python install 3.10\n","!uv venv --python 3.10 /content/latentsync_env\n","!/content/latentsync_env/bin/pip -q install -r /content/LatentSync/requirements.txt\n","!/content/latentsync_env/bin/pip -q install \"huggingface-hub==0.25.2\"\n","\n","from huggingface_hub import snapshot_download\n","snapshot_download(\n","    repo_id=\"ByteDance/LatentSync-1.5\",\n","    local_dir=\"/content/LatentSync/checkpoints\",\n","    ignore_patterns=[\"*.git*\", \"README.md\"]\n",")\n","\n","cache = Path.home() / \".cache/torch/hub/checkpoints\"\n","cache.mkdir(parents=True, exist_ok=True)\n","links = {\n","    \"2DFAN4-cd938726ad.zip\": \"/content/LatentSync/checkpoints/auxiliary/2DFAN4-cd938726ad.zip\",\n","    \"s3fd-619a316812.pth\": \"/content/LatentSync/checkpoints/auxiliary/s3fd-619a316812.pth\",\n","    \"vgg16-397923af.pth\": \"/content/LatentSync/checkpoints/auxiliary/vgg16-397923af.pth\",\n","}\n","for name, source in links.items():\n","    target = cache / name\n","    if target.exists() or target.is_symlink():\n","        target.unlink()\n","    target.symlink_to(source)\n","\n","LIPSYNCED = OUT / \"legadia_lipsynced_8_2s.mp4\"\n","cmd = [\n","    \"/content/latentsync_env/bin/python\", \"-m\", \"scripts.inference\",\n","    \"--unet_config_path\", \"configs/unet/stage2.yaml\",\n","    \"--inference_ckpt_path\", \"checkpoints/latentsync_unet.pt\",\n","    \"--inference_steps\", \"20\",\n","    \"--guidance_scale\", \"1.5\",\n","    \"--video_path\", str(LIPS_VIDEO),\n","    \"--audio_path\", str(VOICE_1),\n","    \"--video_out_path\", str(LIPSYNCED),\n","]\n","subprocess.run(cmd, cwd=\"/content/LatentSync\", check=True)\n","print(\"Sincronización labial:\", LIPSYNCED)\n"]},{"cell_type":"code","execution_count":null,"id":"43829314","metadata":{},"outputs":[],"source":["# 8. Sonido ambiente original, end card exacto y master 1080p\n","import numpy as np\n","from scipy.io import wavfile\n","from scipy.signal import butter, sosfilt\n","from PIL import Image, ImageDraw, ImageFont, ImageFilter\n","\n","SR = 48000\n","DURATION = 10.0\n","n = int(SR * DURATION)\n","t = np.arange(n) / SR\n","rng = np.random.default_rng(20260730)\n","\n","# Ambiente original: terminal, avión lejano, ruedas, impacto y whooshes.\n","noise = rng.normal(0, 1, n)\n","sos = butter(4, 1400, btype=\"lowpass\", fs=SR, output=\"sos\")\n","terminal = sosfilt(sos, noise) * 0.022\n","rumble = (np.sin(2*np.pi*46*t) + 0.45*np.sin(2*np.pi*73*t)) * 0.012\n","ambience = terminal + rumble\n","\n","for when in np.arange(0.4, 7.8, 0.42):\n","    idx = int(when * SR)\n","    length = int(0.045 * SR)\n","    env = np.exp(-np.linspace(0, 8, length))\n","    ambience[idx:idx+length] += rng.normal(0, 1, length) * env * 0.05\n","\n","def add_impact(signal, when, amp=0.25, length=0.7):\n","    idx = int(when * SR)\n","    m = min(int(length*SR), len(signal)-idx)\n","    x = np.arange(m) / SR\n","    env = np.exp(-5*x/length)\n","    hit = (np.sin(2*np.pi*58*x) + 0.5*np.sin(2*np.pi*93*x)) * env * amp\n","    signal[idx:idx+m] += hit\n","\n","def add_whoosh(signal, start, length=0.9, amp=0.12):\n","    idx = int(start*SR)\n","    m = min(int(length*SR), len(signal)-idx)\n","    x = np.linspace(0, 1, m)\n","    sweep = rng.normal(0, 1, m)\n","    sweep = sosfilt(butter(2, [300, 7000], btype=\"bandpass\", fs=SR, output=\"sos\"), sweep)\n","    env = np.sin(np.pi*x)**2\n","    signal[idx:idx+m] += sweep * env * amp\n","\n","add_impact(ambience, 1.25, 0.18)\n","add_whoosh(ambience, 3.1, 1.2, 0.10)\n","add_impact(ambience, 4.2, 0.20)\n","add_whoosh(ambience, 5.3, 1.0, 0.08)\n","add_impact(ambience, 9.55, 0.22)\n","\n","# Breve silencio dramático cerca de la conexión dorada.\n","duck_start, duck_end = int(6.0*SR), int(6.45*SR)\n","ambience[duck_start:duck_end] *= 0.10\n","ambience = np.clip(ambience, -0.95, 0.95)\n","AMBIENCE_WAV = OUT / \"airport_ambience_original.wav\"\n","wavfile.write(AMBIENCE_WAV, SR, (ambience * 32767).astype(np.int16))\n","\n","# Frame para la cartela final.\n","FRAME = OUT / \"end_frame.jpg\"\n","subprocess.run([\n","    \"ffmpeg\", \"-y\", \"-ss\", \"8.1\", \"-i\", str(PREP_VIDEO),\n","    \"-frames:v\", \"1\", str(FRAME)\n","], check=True)\n","\n","img = Image.open(FRAME).convert(\"RGB\").resize((1920, 1080))\n","img = img.filter(ImageFilter.GaussianBlur(radius=4))\n","overlay = Image.new(\"RGBA\", img.size, (0, 0, 0, 0))\n","draw = ImageDraw.Draw(overlay)\n","\n","# Velo cinematográfico.\n","draw.rectangle((0, 0, 1920, 1080), fill=(2, 11, 25, 150))\n","panel = (245, 115, 1675, 965)\n","draw.rounded_rectangle(panel, radius=28, fill=(4, 19, 42, 225),\n","                       outline=(226, 177, 76, 235), width=5)\n","\n","font_bold = \"/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf\"\n","font_regular = \"/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\"\n","headline = ImageFont.truetype(font_bold, 72)\n","body = ImageFont.truetype(font_bold, 58)\n","cta_font = ImageFont.truetype(font_bold, 38)\n","\n","draw.text((330, 200), FINAL_LINES[0], font=headline, fill=(255, 255, 255, 255))\n","draw.text((330, 350), FINAL_LINES[1], font=body, fill=(255, 255, 255, 255))\n","draw.text((330, 465), FINAL_LINES[2], font=body, fill=(226, 177, 76, 255))\n","\n","button = (530, 720, 1390, 835)\n","draw.rounded_rectangle(button, radius=20, fill=(226, 177, 76, 255))\n","bbox = draw.textbbox((0, 0), CTA, font=cta_font)\n","tx = (button[0] + button[2] - (bbox[2]-bbox[0])) / 2\n","ty = (button[1] + button[3] - (bbox[3]-bbox[1])) / 2 - 5\n","draw.text((tx, ty), CTA, font=cta_font, fill=(3, 16, 35, 255))\n","\n","end_card = Image.alpha_composite(img.convert(\"RGBA\"), overlay).convert(\"RGB\")\n","END_CARD = OUT / \"legadia_end_card.png\"\n","end_card.save(END_CARD, quality=95)\n","\n","END_VIDEO = OUT / \"end_card_1_8s.mp4\"\n","subprocess.run([\n","    \"ffmpeg\", \"-y\", \"-loop\", \"1\", \"-i\", str(END_CARD),\n","    \"-t\", \"1.8\", \"-r\", \"25\",\n","    \"-vf\", \"zoompan=z='min(zoom+0.0008,1.035)':d=45:s=1920x1080:fps=25\",\n","    \"-an\", \"-c:v\", \"libx264\", \"-preset\", \"slow\", \"-crf\", \"14\",\n","    \"-pix_fmt\", \"yuv420p\", str(END_VIDEO)\n","], check=True)\n","\n","# CTA retrasada 8,2 s.\n","CTA_DELAYED = OUT / \"voice_cta_delayed.wav\"\n","subprocess.run([\n","    \"ffmpeg\", \"-y\", \"-i\", str(VOICE_2),\n","    \"-filter_complex\", \"adelay=8200|8200,apad=pad_dur=10\",\n","    \"-t\", \"10\", \"-ar\", \"48000\", \"-ac\", \"1\", str(CTA_DELAYED)\n","], check=True)\n","\n","# Voz principal retrasada 0,2 s.\n","VOICE1_DELAYED = OUT / \"voice_main_delayed.wav\"\n","subprocess.run([\n","    \"ffmpeg\", \"-y\", \"-i\", str(VOICE_1),\n","    \"-filter_complex\", \"adelay=200|200,apad=pad_dur=10\",\n","    \"-t\", \"10\", \"-ar\", \"48000\", \"-ac\", \"1\", str(VOICE1_DELAYED)\n","], check=True)\n","\n","VISUAL_10S = OUT / \"legadia_visual_master_10s.mp4\"\n","subprocess.run([\n","    \"ffmpeg\", \"-y\",\n","    \"-i\", str(LIPSYNCED), \"-i\", str(END_VIDEO),\n","    \"-filter_complex\",\n","    \"[0:v]scale=1920:1080:flags=lanczos,trim=duration=8.2,setpts=PTS-STARTPTS[v0];\"\n","    \"[1:v]trim=duration=1.8,setpts=PTS-STARTPTS[v1];\"\n","    \"[v0][v1]concat=n=2:v=1:a=0[v]\",\n","    \"-map\", \"[v]\", \"-t\", \"10\",\n","    \"-c:v\", \"libx264\", \"-preset\", \"slow\", \"-crf\", \"15\",\n","    \"-pix_fmt\", \"yuv420p\", str(VISUAL_10S)\n","], check=True)\n","\n","FINAL = OUT / \"LEGADIA_FINAL_1080P.mp4\"\n","subprocess.run([\n","    \"ffmpeg\", \"-y\",\n","    \"-i\", str(VISUAL_10S),\n","    \"-i\", str(AMBIENCE_WAV),\n","    \"-i\", str(VOICE1_DELAYED),\n","    \"-i\", str(CTA_DELAYED),\n","    \"-filter_complex\",\n","    \"[1:a]volume=0.62[a1];\"\n","    \"[2:a]volume=1.25[a2];\"\n","    \"[3:a]volume=1.30[a3];\"\n","    \"[a1][a2][a3]amix=inputs=3:duration=longest:normalize=0,\"\n","    \"alimiter=limit=0.95[a]\",\n","    \"-map\", \"0:v\", \"-map\", \"[a]\",\n","    \"-t\", \"10\",\n","    \"-c:v\", \"copy\",\n","    \"-c:a\", \"aac\", \"-b:a\", \"320k\",\n","    \"-movflags\", \"+faststart\",\n","    str(FINAL)\n","], check=True)\n","\n","print(\"ARCHIVO FINAL:\", FINAL)\n"]},{"cell_type":"code","execution_count":null,"id":"6f9da88c","metadata":{},"outputs":[],"source":["# 9. Reproducción y descarga\n","from IPython.display import Video, display\n","from google.colab import files\n","\n","FINAL = OUT / \"LEGADIA_FINAL_1080P.mp4\"\n","display(Video(str(FINAL), embed=True, width=960))\n","files.download(str(FINAL))\n"]}],"metadata":{"colab":{"name":"LEGADIA_CogVideoX_Colab.ipynb","provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":5}